rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super admin is hard-coded by email. email_verified is required so nobody
    // can take over the role by registering this address without owning it.
    function isSuper() {
      return request.auth != null &&
        request.auth.token.email == 'check@veri.com' &&
        request.auth.token.email_verified == true;
    }
    // Other staff are listed in admins/{uid}, managed by the super admin.
    function isAdmin() {
      return isSuper() || (request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Public can read one record if they know its ID, but cannot list/browse.
    match /documents/{id} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.status in ['valid', 'revoked'];
    }
    match /settings/portal {
      allow get: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list, create, update, delete: if isSuper();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
